APP_DATABASE_URL=sqlite+aiosqlite:///./app.db

# Authentication and password-based sign-in.
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=project-release-api
AUTH_JWT_AUDIENCE=project-release-client
AUTH_ACCESS_TOKEN_MINUTES=60

# GitHub MCP is disabled until these values are configured.
GITHUB_ENABLED=false
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_OWNER=
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_TOOLSETS=repos,issues,pull_requests,actions
GITHUB_MCP_IMAGE=ghcr.io/github/github-mcp-server:v1.7.0
GITHUB_MCP_TRANSPORT=http
GITHUB_MCP_URL=http://127.0.0.1:8082/mcp
GITHUB_MCP_PORT=8082

# Mutating operations have separate safety gates.
GITHUB_WRITE_ENABLED=false
GITHUB_MERGE_ENABLED=false
GITHUB_RELEASE_ENABLED=false

# Local coding-agent execution. Each project runs from its configured folder path.
LOCAL_AGENT_ENABLED=false
LOCAL_AGENT_PROVIDER=codex
LOCAL_AGENT_MODEL_NAME=
LOCAL_AGENT_GIT_COMMAND=git
LOCAL_AGENT_GIT_REMOTE=origin
LOCAL_AGENT_CODEX_COMMAND=codex
LOCAL_AGENT_CLAUDE_COMMAND=claude
# Ollama uses Codex CLI's --oss provider so it retains coding-agent tools.
LOCAL_AGENT_OLLAMA_COMMAND=codex
LOCAL_AGENT_TIMEOUT_SECONDS=3600
LOCAL_AGENT_MAX_OUTPUT_CHARACTERS=100000
LOCAL_AGENT_PUSH_ENABLED=true

# Celery uses Redis for task delivery and results. Beat scans for planned todos.
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/1
CELERY_PLANNED_TODO_SCAN_SECONDS=30
CELERY_GITHUB_TASK_SCAN_SECONDS=1
CELERY_PLANNED_TODO_BATCH_SIZE=10
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_AGENT_EXECUTION_LOCK_KEY=project-release-api:agent-execution
CELERY_AGENT_EXECUTION_LOCK_RETRY_SECONDS=5
CELERY_TASK_EVENTS_CHANNEL=project-release-api:agent-events
REDIS_PORT=6380
